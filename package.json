{
  "name": "@einsy.dev/web-tools",
  "version": "1.0.5",
  "description": "Useful tools pack",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsup && node ./build.js",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major",
    "publish": "npm run build && npm publish"
  },
  "keywords": [
    "chrome",
    "extension",
    "tools",
    "web-tools"
  ],
  "author": "einsy-dev",
  "license": "ISC",
  "files": [
    "./*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./findElement": {
      "import": "./findElement/index.mjs",
      "require": "./findElement/index.cjs"
    },
    "./genKey": {
      "import": "./genKey/index.mjs",
      "require": "./genKey/index.cjs"
    },
    "./LS": {
      "import": "./localStorage/index.mjs",
      "require": "./localStorage/index.cjs"
    },
    "./pathname": {
      "import": "./pathName/index.mjs",
      "require": "./pathName/index.cjs"
    }
  },
  "devDependencies": {
    "@types/node": "~20.14.10",
    "tsup": "^8.3.5",
    "typescript": "~5.5.3"
  },
  "dependencies": {
    "undici-types": "^5.26.5"
  }
}